profile: production
exclude_paths:
  - .github/
  - .ansible-lint
  - venv/
  - .git/
warn_list:
  - no-handler
  - var-spacing
  - var-naming
  - yaml[comments-indentation]
skip_list:
  - experimental
  - yaml[line-length]
enable_list:
  - no-log-password
  - loop-var-prefix
# The examples reference the role by its Galaxy name, which is not installed
# when linting the repo itself.
mock_roles:
  - devopsgroupeu.hetzner-cloud
