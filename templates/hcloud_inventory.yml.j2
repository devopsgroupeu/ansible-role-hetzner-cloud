# Hetzner Cloud static inventory - generated by ansible-role-hetzner-cloud
# Source role variable: hcloud_provisioned_servers
# Prefer the hetzner.hcloud dynamic inventory plugin for stateless hand-off.
# ansible_host is the public IPv4, or the first private IP for servers
# without one (enable_ipv4: false).
#
# Groups come from hcloud_inventory_groups (group name -> 'role' label value).
# Servers whose role label matches no group are listed under ungrouped.

{% set servers = hcloud_provisioned_servers | default([]) %}
{% set group_roles = hcloud_inventory_groups.values() | list %}
{% set ungrouped = servers | rejectattr('labels.role', 'defined') | list + (servers | selectattr('labels.role', 'defined') | rejectattr('labels.role', 'in', group_roles) | list) %}
all:
  children:
{% for group, role in hcloud_inventory_groups.items() %}
{% set members = servers | selectattr('labels', 'defined') | selectattr('labels.role', 'defined') | selectattr('labels.role', 'equalto', role) | list %}
    {{ group }}:
      hosts:
{% if members | length > 0 %}
{% for srv in members %}
        {{ srv.name }}:
          ansible_host: {{ srv.ipv4_address | default('', true) or ((srv.private_networks_info | default([]) | map(attribute='ip') | first) | default('')) }}
          hcloud_private_ip: {{ (srv.private_networks_info | default([]) | map(attribute='ip') | first) | default('') }}
{% endfor %}
{% else %}
        {}
{% endif %}
{% endfor %}
{% if ungrouped | length > 0 %}
    ungrouped:
      hosts:
{% for srv in ungrouped %}
        {{ srv.name }}:
          ansible_host: {{ srv.ipv4_address | default('', true) or ((srv.private_networks_info | default([]) | map(attribute='ip') | first) | default('')) }}
          hcloud_private_ip: {{ (srv.private_networks_info | default([]) | map(attribute='ip') | first) | default('') }}
{% endfor %}
{% endif %}
